<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent so AppCompatActivity + per-app locales work; the real
         visual theming happens in Compose (FuelRadarTheme, dark only — night
         mode is forced in FuelRadarApp). Dark window background avoids a light
         flash before the Compose splash. -->
    <style name="Theme.FuelRadar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_dark</item>
    </style>
</resources>
